<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: la pantalla de arranque del sistema usa la noche de RAKÜN.
         El ícono definitivo con el isotipo llega en la Fase 8. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/rakun_noche</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/rakun_noche</item>
    </style>
</resources>
